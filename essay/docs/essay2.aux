\@writefile{lot}{\contentsline {table}{\numberline {6.1}{\ignorespaces 三信号分位数分层消融主结果：\texttt  {Spec@R99.5}。加粗为各信号的 peak bucket，$\Delta $ 为相对 G0 的增量。三个信号的 peak 均不在 Q1（最高信号值），而分别落在 Q2（$R$）、Q4（$C$）和 Q3（$D$），呈现非单调价值--信号响应（Goldilocks pattern）。\textbf  {注：本表数据待在扩展验证集（707 正常样本）上重新评估。}}}{44}{table.caption.51}\protected@file@percent }
\newlabel{tab:bucket-pilot-main}{{6.1}{44}{三信号分位数分层消融主结果：\formalmetric {Spec@R99.5}。加粗为各信号的 peak bucket，$\Delta $ 为相对 G0 的增量。三个信号的 peak 均不在 Q1（最高信号值），而分别落在 Q2（$R$）、Q4（$C$）和 Q3（$D$），呈现非单调价值--信号响应（Goldilocks pattern）。\textbf {注：本表数据待在扩展验证集（707 正常样本）上重新评估。}}{table.caption.51}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3.3}Goldilocks 效应分析}{44}{subsection.6.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3.4}单调加权假设的反证}{45}{subsection.6.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces 单调加权假设的反证。(a) 假设采用 $\pi _i \propto R_i^2$ 的单调评分，84\% 以上的采样预算将集中在 Q1（最高 $R$ 值样本）。(b) 分位数消融表明 Q1 的 Spec@R99.5 低于 G0 基线（$-$0.0238），而 Q2 才是 peak（$+$0.0714）。单调加权将预算系统性地投向最低价值分位桶。}}{45}{figure.caption.52}\protected@file@percent }
\newlabel{fig:goldilocks-attribution}{{6.1}{45}{单调加权假设的反证。(a) 假设采用 $\pi _i \propto R_i^2$ 的单调评分，84\% 以上的采样预算将集中在 Q1（最高 $R$ 值样本）。(b) 分位数消融表明 Q1 的 Spec@R99.5 低于 G0 基线（$-$0.0238），而 Q2 才是 peak（$+$0.0714）。单调加权将预算系统性地投向最低价值分位桶。}{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces 三信号分位数分层消融的非单调价值--信号响应（Goldilocks pattern）。$R$ 信号 peak 落在 Q2（$+$0.0714,6 个正常样本），$C$ 信号 peak 落在 Q4（$+$0.0595），$D$ 信号 peak 落在 Q3（$+$0.0595）。$R$-Q1（最高边界风险）的 Spec@R99.5 反而低于 G0 基线。拟合二次曲线可视化非单调 shape。}}{46}{figure.caption.53}\protected@file@percent }
\newlabel{fig:bucket-goldilocks-panel}{{6.2}{46}{三信号分位数分层消融的非单调价值--信号响应（Goldilocks pattern）。$R$ 信号 peak 落在 Q2（$+$0.0714,6 个正常样本），$C$ 信号 peak 落在 Q4（$+$0.0595），$D$ 信号 peak 落在 Q3（$+$0.0595）。$R$-Q1（最高边界风险）的 Spec@R99.5 反而低于 G0 基线。拟合二次曲线可视化非单调 shape。}{figure.caption.53}{}}
