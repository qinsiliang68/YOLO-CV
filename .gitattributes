* text=auto

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.webp binary
*.tif binary
*.tiff binary
*.pt binary
*.onnx binary
*.engine binary

# GapValue v1.1 was frozen on Windows and its immutable SHA-256 contracts bind
# the CRLF byte representation. Keep this scope narrow so historical CSVs are
# unaffected while fresh Windows/Linux checkouts reproduce the frozen hashes.
artifacts/stage1_sample_value_experiments/contracts/gapvalue240_v1_1/**/*.csv text eol=crlf

# The lightweight analysis package carries a byte-level SHA-256 manifest.
# Disable checkout-time newline conversion so every listed hash stays portable.
artifacts/stage1_sample_value_experiments/experiments/oof_dynamics_gap_value_20260708/06_reports/gapvalue240_full_analysis_20260728_v1_git/** -text

# Raw SCTSR TDD logs preserve the test runner's exact stdout/stderr bytes,
# including diagnostic whitespace. Do not rewrite evidence merely to satisfy a
# source-formatting heuristic; each receipt is SHA-bound separately.
docs/stage1_sctsr_v4/tdd_receipts/** -whitespace

# SCTSR v4 implementation-audit evidence is byte-bound by an explicit
# SHA-256 manifest. Preserve the exact stdout, stderr, JSON, Parquet, reviewed
# snapshots, and synthetic receipts instead of applying text normalization.
artifacts/stage1_sample_value_experiments/experiments/dynamic_replay_budget_efficiency_20260807/08_reports/sctsr_v4_implementation_audit_20260813/** -text -eol -whitespace
